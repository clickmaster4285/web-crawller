# Copy to .env and adjust for your machine. The real .env is gitignored.

# Server Configuration
NODE_ENV=development
PORT=3000

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/crawler-new

# ── Crawl Infrastructure ────────────────────────────────────────────────
# Worker processes spawned by the API in dev (each handles one crawl at a
# time; queued crawls run in parallel across workers). 0 = don't spawn any
# (run `npm run worker` yourself). Prod default is 0 — deploy N workers.
PARITY_WORKERS=3

# 0 disables auto-spawning of workers + scheduler entirely (PARITY_INFRA=0).
# PARITY_INFRA=1

# Spawn the scheduler alongside the API? 0 = run `npm run scheduler` yourself.
# PARITY_SCHEDULER=1

# Scheduler scan interval (ms) — how often it checks Store cadences.
# PARITY_SCHEDULER_TICK_MS=60000

# Worker heartbeat interval (ms) — liveness + live progress updates.
# PARITY_HEARTBEAT_MS=2000

# Idle wait (ms) when no job is due — how fast a worker picks up new work.
# PARITY_WORKER_IDLE_MS=2000

# How often the worker re-reads the job's control field for pause/cancel.
# PARITY_CONTROL_POLL_MS=1500

# A claimed job whose heartbeat is older than this is released and requeued
# (crash recovery).
# PARITY_HEARTBEAT_TIMEOUT_MS=60000

# Hard cap per job (ms) — a wedged crawl is released even with fresh beats.
# PARITY_JOB_TIMEOUT_MS=21600000

# Retry attempts before a job goes dead.
# PARITY_MAX_ATTEMPTS=3

# Retry backoff base (ms) — doubles per attempt, capped at 15 min.
# PARITY_BACKOFF_BASE_MS=15000

# Worker V8 heap cap (MB) — bounds each crawl worker so its heap cannot
# balloon to a multi-GB high-water mark that never returns to the OS. Lower
# it (e.g. 2048) on memory-tight machines; raise it for huge stores.
PARITY_WORKER_MAX_OLD_SPACE_MB=3072
